# Yandex Tracker MCP Server - Environment Variables Example
# Copy this file to .env and fill in your values

# Transport mode (stdio, sse, streamable-http)
TRANSPORT=streamable-http

# Authentication (choose one)
TRACKER_TOKEN=your-oauth-token-here
# TRACKER_IAM_TOKEN=your-iam-token-here

# Organization (choose one)
TRACKER_ORG_ID=your-org-id
# TRACKER_CLOUD_ORG_ID=your-cloud-org-id

# Optional settings
# TRACKER_LIMIT_QUEUES=QUEUE1,QUEUE2
# TRACKER_READ_ONLY=true
# TOOLS_CACHE_ENABLED=true
# OAUTH_ENABLED=true
